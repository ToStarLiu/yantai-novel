# Copy to .env. Keep .env outside version control. Values are literal; no shell expansion.
# Portable Windows development database (scripts/dev.ps1 -Action db-start):
DATABASE_URL=postgres://novel@127.0.0.1:55432/novel?sslmode=disable
# Tests create and remove their own schemas; they do not reuse the application schema.
TEST_DATABASE_URL=postgres://novel@127.0.0.1:55432/novel?sslmode=disable

# Optional Compose database: set a strong password, and add its URL-encoded value
# to DATABASE_URL and TEST_DATABASE_URL. Do not run Compose and portable PG on the same port.
POSTGRES_PASSWORD=

# CLI evaluation requires explicit --provider configured for real calls.
# The web app uses auto: all three fields empty starts an explicit demo;
# a complete environment connection uses that provider. Or configure it in the page.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Select responses or chat according to your configured endpoint.
LLM_WIRE_API=responses
# Optional provider-specific actor authorization; never log or commit its value.
LLM_ACTOR_AUTHORIZATION=
# Provider prices are not yet configured; monetary cost remains Unknown/null.

# dev.ps1 uses this mirror only when GOPROXY is absent. Go checksum verification stays enabled.
GOPROXY=https://goproxy.cn,direct

# Initial administrator login. Other accounts use persistent invitations and roles.
# Use at least 12 characters for AUTHOR_PASSWORD.
AUTHOR_USERNAME=author
AUTHOR_PASSWORD=
# Optional encryption key path for credentials saved through the AI settings page.
# Default: .local/provider-master.key; preserve with database backups.
PROVIDER_MASTER_KEY_PATH=
APP_ADDR=127.0.0.1:8088
PUBLIC_ORIGIN=http://127.0.0.1:8088
COOKIE_SECURE=false
APP_PROVIDER=auto
RUN_WORKER=true
MAX_OUTPUT_TOKENS=3000
MAX_CONCURRENT_JOBS=2

# Optional per-task models (same compatible provider endpoint).
LLM_REVIEW_MODEL=
LLM_MEMORY_MODEL=
LLM_PLANNING_MODEL=
LLM_REVIEW_INPUT_PRICE_PER_MILLION=
LLM_REVIEW_OUTPUT_PRICE_PER_MILLION=
LLM_MEMORY_INPUT_PRICE_PER_MILLION=
LLM_MEMORY_OUTPUT_PRICE_PER_MILLION=
LLM_PLANNING_INPUT_PRICE_PER_MILLION=
LLM_PLANNING_OUTPUT_PRICE_PER_MILLION=
# Optional prices per million tokens; currency must match your provider invoice.
# When absent, cost remains Unknown and a monetary budget blocks unpriced calls.
LLM_INPUT_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=
LLM_CURRENCY=
MAX_JOB_COST=

# Optional cover and speech providers. Blank model disables that generation kind.
# MEDIA_BASE_URL / MEDIA_API_KEY fall back to the LLM connection when absent.
MEDIA_BASE_URL=
MEDIA_API_KEY=
IMAGE_MODEL=
TTS_MODEL=
PDF_FONT_PATH=assets/fonts/NotoSansSC-Regular.ttf

# Public MCP protocol endpoint /mcp: disabled until a random >=24-character token is set.
# Keep this token on the server and in trusted client configuration only.
MCP_SERVER_TOKEN=

# Optional compatible search endpoint; direct public URL research works independently.
RESEARCH_SEARCH_URL=
RESEARCH_SEARCH_API_KEY=
